NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Sentry (monitoreo de errores). NEXT_PUBLIC_ a proposito: el navegador
# manda los eventos directo al ingest de Sentry, necesita ver el DSN. Sin
# esta variable Sentry no se inicializa y el front arranca igual.
NEXT_PUBLIC_SENTRY_DSN=
# Opcional — si falta, usa NODE_ENV. Sin esto, staging y produccion
# mandarian todo a la misma etiqueta "production" y se mezclarian en el
# mismo tablero.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
