generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  OWNER
  WALKER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WalkStatus {
  PENDING
  CONFIRMED
  WALKER_ON_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED_OWNER
  CANCELLED_WALKER
  NOT_PERFORMED
}

// La caja (WalkStatus.NOT_PERFORMED) dice QUE paso; el motivo dice QUIEN
// fallo. Se llama asi y no EXPIRED (como estaba disenado originalmente)
// porque EXPIRED describe bien "se pudrio solo" y describe mal el caso donde
// el paseador fue, espero y declaro que el dueño no aparecio — ahi no expiro
// nada, alguien actuo. El motivo es el que decide la plata (bloque E).
enum NotPerformedReason {
  // Nunca marco "en camino" y paso T + duracion del WalkType. Dos caminos
  // distintos llegan a este mismo motivo: el job (WalkExpirationService,
  // automatico) y el boton del dueño "el paseador no se presento"
  // (bloque B, manual, desde T+10m) — el motivo es el mismo, cambia solo
  // quien lo detecto.
  WALKER_NO_SHOW
  ON_WAY_NEVER_STARTED  // marco "en camino" y despues silencio: nunca inicio ni reclamo nada
  OWNER_NO_SHOW         // el paseador lo declara con GPS (boton, bloque D)
  // Canario, no una regla real: si un paseo termina acá es que apareció un
  // estado que el resto del job no supo nombrar (ej. CONFIRMED con onWayAt
  // seteado — no debería poder pasar por la app, pero una intervención
  // manual por SQL sí puede dejarlo así). Si esto empieza a aparecer en los
  // logs, hay un caso sin mapear y hay que investigarlo, no ignorarlo.
  NOBODY_ACTED
  NEVER_CONFIRMED       // job: quedo PENDING y paso la hora pactada
}

// Quien cerro el paseo (COMPLETED). Dato de prolijidad para el historial del
// paseador, no de puntualidad: un WALKER que nunca cierra sus propios
// paseos y depende de que el dueño confirme la recepcion es una señal
// distinta (y de la misma familia) que llegar tarde. ADMIN queda definido
// para cuando exista el cierre manual desde el panel (politicas.md lo
// menciona como "segunda llave") — todavia no hay endpoint que lo setee.
enum ClosedBy {
  WALKER
  OWNER
  ADMIN
}

enum WalkMode {
  GRUPAL
  EXCLUSIVO
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── USUARIOS ────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerifiedAt  DateTime?
  refreshTokenHash String?

  ownerProfile    OwnerProfile?
  walkerProfile   WalkerProfile?
  sentMessages    Message[]      @relation("SentMessages")
  notifications   Notification[]
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
}

// ─── PERFIL DUEÑO ────────────────────────────────────────

model OwnerProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  address      String?
  neighborhood String?
  lat          Float?
  lng          Float?

  dogs             Dog[]
  walkParticipants WalkParticipant[]
  conversations    Conversation[]
}

// ─── PERFIL PASEADOR ─────────────────────────────────────

model WalkerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  bio                String?
  dniNumber          String?
  dniPhotoUrl        String?
  selfieUrl          String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  rating             Float              @default(0)
  totalReviews       Int                @default(0)
  isAvailable        Boolean            @default(false)
  maxDogsPerWalk     Int                @default(6)
  centerLat          Float?
  centerLng          Float?
  radiusKm           Float?
  mpAccessToken      String?
  mpUserId           String?

  schedules     WalkerSchedule[]
  walks         Walk[]
  payouts       Payout[]
  conversations Conversation[]
}

// ─── HORARIOS DEL PASEADOR ───────────────────────────────

model WalkerSchedule {
  id        String        @id @default(uuid())
  walkerId  String
  walker    WalkerProfile @relation(fields: [walkerId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean       @default(true)
}

// ─── PERROS ──────────────────────────────────────────────

model Dog {
  id        String       @id @default(uuid())
  ownerId   String
  owner     OwnerProfile @relation(fields: [ownerId], references: [id])
  name      String
  breed     String?
  size      String
  ageYears  Int?
  weightKg  Float?
  photoUrl  String?
  notes     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  walkParticipants WalkParticipant[]
}

// ─── TIPOS DE PASEO (PRICING) ────────────────────────────

model WalkType {
  id                  String  @id @default(uuid())
  durationMinutes     Int     @unique
  label               String
  basePrice           Float
  exclusiveMultiplier Float   @default(1.5)
  isActive            Boolean @default(true)

  walks Walk[]
}

// ─── PASEOS ──────────────────────────────────────────────

model Walk {
  id                 String        @id @default(uuid())
  walkTypeId         String
  walkType           WalkType      @relation(fields: [walkTypeId], references: [id])
  walkerId           String
  walker             WalkerProfile @relation(fields: [walkerId], references: [id])
  mode               WalkMode      @default(GRUPAL)
  status             WalkStatus    @default(PENDING)
  scheduledAt        DateTime
  onWayAt            DateTime?
  startedAt          DateTime?
  // true si startedAt quedo mas de WALK_TIMING.START_LATE_THRESHOLD_MIN_AFTER
  // despues de scheduledAt. Se calcula UNA vez en start() y se persiste — no
  // se deriva en lectura como isExpired — porque alimenta la tasa de
  // puntualidad del paseador: necesita agregarse por SQL sobre muchos paseos
  // (WHERE startedLate) sin traer cada fila a memoria, y tiene que quedar
  // fijo aunque el umbral cambie mas adelante (una decision "fue tardio"
  // tomada con la regla vigente en ese momento no se reescribe sola).
  startedLate        Boolean              @default(false)
  endedAt            DateTime?
  // true si endedAt quedo mas de WALK_TIMING.END_LATE_THRESHOLD_MIN_AFTER
  // despues del fin esperado (startedAt + duracion del WalkType). Mismo
  // criterio que startedLate y las mismas dos razones: se persiste (no se
  // deriva) porque alimenta metricas que se agregan por SQL sobre muchos
  // paseos sin traer cada fila a memoria, y porque envenena cualquier
  // promedio de duracion si no se puede excluir (un paseo de 2h cerrado 20h
  // despues da endedAt-startedAt = 20h, un numero que no describe nada real).
  endedLate          Boolean              @default(false)
  // Quien confirmo que el paseo termino. WALKER cuando lo cierra el propio
  // paseador (finish()); OWNER cuando el dueño confirma la recepcion porque
  // el paseador no lo hizo (confirmReceipt()) — la llave de escape del
  // bloqueo del bloque B. Null mientras el paseo no llego a COMPLETED.
  closedBy           ClosedBy?
  notPerformedReason NotPerformedReason?
  notPerformedAt     DateTime?
  pickupLat          Float
  pickupLng          Float
  pickupAddress      String
  totalAmount        Float
  platformFee        Float
  walkerAmount       Float
  commissionRate     Float
  mpPaymentId        String?
  mpRefundId         String?
  refundedAt         DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  participants WalkParticipant[]
  locations    WalkLocation[]
  reviews      Review[]
  conversation Conversation?

  // Los cuatro pases de WalkExpirationService (cada 5 min, 288 corridas por
  // dia) filtran siempre por estos dos campos juntos. Sin este indice,
  // Postgres escanea la tabla entera en cada pase — y todos ademas hacen
  // orderBy + take (para agarrar los 50 mas vencidos), el peor caso: tienen
  // que leer y ordenar todo para saber cuales son esos 50. Se agrega ahora,
  // con la tabla en decenas de filas: sobre una tabla grande, CREATE INDEX
  // es una operacion que hay que planificar, no algo para hacer despues.
  @@index([status, scheduledAt])
}

// ─── PARTICIPANTES DEL PASEO ─────────────────────────────

model WalkParticipant {
  id         String       @id @default(uuid())
  walkId     String
  walk       Walk         @relation(fields: [walkId], references: [id])
  ownerId    String
  owner      OwnerProfile @relation(fields: [ownerId], references: [id])
  dogId      String
  dog        Dog          @relation(fields: [dogId], references: [id])
  amountPaid Float
  joinedAt   DateTime     @default(now())

  @@unique([walkId, dogId])
}

// ─── TRACKING GPS ────────────────────────────────────────

model WalkLocation {
  id         String   @id @default(uuid())
  walkId     String
  walk       Walk     @relation(fields: [walkId], references: [id])
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  @@index([walkId, recordedAt])
}

// ─── REVIEWS ─────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  walkId     String
  walk       Walk     @relation(fields: [walkId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([walkId, reviewerId])
}

// ─── CHAT ────────────────────────────────────────────────

model Conversation {
  id        String        @id @default(uuid())
  walkId    String?       @unique
  walk      Walk?         @relation(fields: [walkId], references: [id])
  ownerId   String
  owner     OwnerProfile  @relation(fields: [ownerId], references: [id])
  walkerId  String
  walker    WalkerProfile @relation(fields: [walkerId], references: [id])
  createdAt DateTime      @default(now())

  messages Message[]
}

model Message {
  id                  String       @id @default(uuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id])
  senderId            String
  sender              User         @relation("SentMessages", fields: [senderId], references: [id])
  content             String
  isRead              Boolean      @default(false)
  containsContactInfo Boolean      @default(false)
  createdAt           DateTime     @default(now())
}

// ─── NOTIFICACIONES ──────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── PAGOS A PASEADORES ──────────────────────────────────

model Payout {
  id           String        @id @default(uuid())
  walkerId     String
  walker       WalkerProfile @relation(fields: [walkerId], references: [id])
  amount       Float
  periodStart  DateTime
  periodEnd    DateTime
  status       PayoutStatus  @default(PENDING)
  mpTransferId String?
  createdAt    DateTime      @default(now())
}
