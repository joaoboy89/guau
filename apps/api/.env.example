DATABASE_URL=postgresql://guau:devpassword@localhost:5433/guau?schema=public

JWT_SECRET=cambiar_por_un_string_random_largo
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_por_otro_string_random_largo
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_SECRET=cambiar_por_otro_string_random_largo

MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# FRACCIÓN del precio (0.15 = 15%), NO porcentaje. Debe estar entre 0 y 1.
MP_MARKETPLACE_FEE=0.15
MP_WEBHOOK_SECRET=

# Clave AES-256-GCM para cifrar mpAccessToken en la DB. Generá con: openssl rand -hex 32
ENCRYPTION_KEY=

# Secreto del desplazamiento del punto de encuentro que ve el paseador antes
# de apretar "voy en camino" (anti-desintermediación). Sin esto, el cálculo
# saldría solo del walkId — un dato público (el propio paseador lo tiene) con
# un algoritmo público (el repo lo es) — y cualquiera lo revertiría con una
# resta. La API NO ARRANCA sin esta variable (mínimo 16 caracteres), a
# propósito: mejor un deploy que falla ruidoso que uno que anda sin
# protección real. Generá con: openssl rand -hex 32
PICKUP_ZONE_SECRET=

SWAGGER_USER=
SWAGGER_PASSWORD=

COOKIE_DOMAIN=

RESEND_API_KEY=
EMAIL_FROM=noreply@tudominio.com
# Destino de las alertas internas (ej. paseo NOT_PERFORMED con plata adentro).
# Si falta, el job sigue funcionando igual y solo deja un warning en el log.
ADMIN_ALERT_EMAIL=

API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
