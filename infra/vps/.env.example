# ── Acceso al repo privado de GitHub ──────────────────────────
# Generá un token en: github.com/settings/tokens/new
# Permisos necesarios: Contents → Read-only sobre el repo guau
GH_TOKEN=

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_PASSWORD=cambia_esta_password_muy_segura

# ── JWT (generá con: openssl rand -hex 32) ────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# ── App ───────────────────────────────────────────────────────
PORT=3001
API_URL=https://tu-dominio-api.com
FRONTEND_URL=https://tu-dominio-frontend.com

# ── Email (Resend — resend.com) — opcional para pruebas ───────
# Sin clave: el registro funciona pero no llega el mail de verificación
RESEND_API_KEY=

# ── MercadoPago ───────────────────────────────────────────────
# Nombres exactos que usa el código (MP_*, no MERCADOPAGO_*)
# Sin configurar: la app arranca bien, los endpoints de pago retornan error
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=

# ── Sentry (monitoreo de errores) ───────────────────────────────
# API: sin esto Sentry no se inicializa y la API arranca igual.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Web: esto SOLO alimenta el lado servidor de Next en runtime
# (instrumentation.ts, vía docker-compose.yml). El navegador nunca lee
# esta variable — su DSN queda horneado en el bundle en build time por
# el build-arg de .github/workflows/docker.yml (secreto SENTRY_DSN_WEB).
# Poné acá el mismo valor que ese secreto, para que servidor y navegador
# reporten al mismo proyecto de Sentry.
NEXT_PUBLIC_SENTRY_DSN=
