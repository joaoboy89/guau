# ── Acceso al repo privado de GitHub ──────────────────────────
# Generá un token en: github.com/settings/tokens/new
# Permisos necesarios: Contents → Read-only sobre el repo guau
GH_TOKEN=

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_PASSWORD=cambia_esta_password_muy_segura

# ── JWT (generá con: openssl rand -hex 32) ────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# ── App ───────────────────────────────────────────────────────
PORT=3001
API_URL=http://38.54.57.20:3001
FRONTEND_URL=http://38.54.57.20:3000

# ── Email (Resend — resend.com) — opcional para pruebas ───────
# Sin clave: el registro funciona pero no llega el mail de verificación
RESEND_API_KEY=

# ── MercadoPago ───────────────────────────────────────────────
# Nombres exactos que usa el código (MP_*, no MERCADOPAGO_*)
# Sin configurar: la app arranca bien, los endpoints de pago retornan error
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
