# ── Acceso al repo privado de GitHub ──────────────────────────
# Generá un token en: github.com/settings/tokens/new
# Permisos necesarios: repo (read-only) → "Contents: Read"
GH_TOKEN=

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_PASSWORD=cambia_esta_password_muy_segura

# ── JWT (generá con: openssl rand -hex 32) ────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# ── App ───────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://38.54.57.20:3000

# ── Email (Resend — resend.com) ────────────────────────────────
RESEND_API_KEY=

# ── MercadoPago ───────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
