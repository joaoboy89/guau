# -- Stage 1: deps ------------------------------------------------------------
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN npm ci --legacy-peer-deps

# -- Stage 2: builder ---------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=http://38.54.57.20:3001
ARG NEXT_PUBLIC_WS_URL=http://38.54.57.20:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
COPY --from=deps /app/node_modules ./node_modules
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
COPY package.json ./
RUN cd apps/web && npx next build
# Prunar devDependencies para que el runner tenga solo lo necesario en prod
RUN npm prune --omit=dev --legacy-peer-deps

# -- Stage 3: runner ----------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

# Standalone: server.js + .next/server/ quedan en /app/
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

# Static en /app/.next/static/ — donde server.js los busca
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./.next/static

# Public en /app/public/ — donde server.js los busca
COPY --from=builder /app/apps/web/public ./public

# node_modules ya prunados (sin devDeps) desde el builder
COPY --from=builder /app/node_modules ./node_modules

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
